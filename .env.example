DOMAIN=example.com
MAIL_HOST=0.0.0.0
SMTP_PORT=25
WEB_HOST=0.0.0.0
WEB_PORT=8787

# Random long token untuk akses API dari script/bot (header: x-api-token)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=ubah-token-random-panjang

# Access code untuk login dashboard browser (4-8 digit/karakter direkomendasikan).
# Kosongkan untuk mematikan login dashboard (mode dev).
ACCESS_CODE=change-me-4to8-digits

DB_PATH=./tempmail.sqlite3
MAX_MESSAGE_BYTES=10485760
