# Server
DOMAIN=example.com
MAIL_HOST=0.0.0.0
SMTP_PORT=25
WEB_HOST=0.0.0.0
WEB_PORT=8787

# Storage
DB_PATH=tempmail.sqlite3
MAX_MESSAGE_BYTES=10485760

# Email retention (auto-delete inbox older than N hours)
EMAIL_RETENTION_HOURS=48

# Bootstrap super_admin (only used pertama kali — setelah user pertama dibuat di DB,
# var ini diabaikan. Default: super_admin / super_admin)
SUPER_ADMIN_USER=super_admin
SUPER_ADMIN_PASS=change-me-on-first-login

# Master API token (super_admin power, untuk bot/script)
API_TOKEN=YOUR_API_TOKEN

# DEPRECATED — kept for backward compat. Login sekarang pakai username+password.
ACCESS_CODE=
